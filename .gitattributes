# 统一换行符，避免 Windows / macOS / Linux 之间来回改行尾
* text=auto eol=lf

# 明确的文本类型
*.js      text eol=lf
*.mjs     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.py      text eol=lf
*.svg     text eol=lf
*.webmanifest text eol=lf

# 二进制文件不要做行尾转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.ico     binary
*.woff2   binary
*.wasm    binary
*.tar     binary

# 让 GitHub 语言统计更准确
*.html    linguist-documentation=false
docs/screenshots/*.png binary
