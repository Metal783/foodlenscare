{
  "name": "foodlenscare-v5",
  "private": true,
  "version": "5.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/prepare-offline.mjs",
    "build:pages": "node tools/build-pages.mjs",
    "build:all": "npm run build && npm run build:pages",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test:rules": "node tools/rule-selftest.mjs",
    "serve": "python -X utf8 tools/family_server.py --open",
    "android:sync": "npm run build && cap sync android",
    "android:build": "powershell -NoProfile -ExecutionPolicy RemoteSigned -File tools/build-android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
